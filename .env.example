GOOGLE_MAPS_ANDROID_KEY=
GOOGLE_MAPS_IOS_KEY=

APPLE_MAPS_TEAM_ID=
APPLE_MAPS_KEY_ID=
APPLE_MAPS_PRIVATE_KEY_PATH=
MAPS_SERVER_HOST=127.0.0.1
EXPO_PUBLIC_MAPS_SERVER_URL=

# Vision server (npm run vision-server). Provider: gemini if GEMINI_API_KEY is set,
# else openai if OPENAI_API_KEY is set, else a labeled mock. Force with VISION_PROVIDER.
VISION_PROVIDER=
GEMINI_API_KEY=
GEMINI_MODEL=
OPENAI_API_KEY=
OPENAI_MODEL=
# 127.0.0.1 by default. For phone testing on a trusted Wi-Fi only, set 0.0.0.0
VISION_SERVER_HOST=127.0.0.1
# What the phone calls, e.g. http://192.168.1.20:8788 (your computer's LAN address)
EXPO_PUBLIC_VISION_SERVER_URL=
